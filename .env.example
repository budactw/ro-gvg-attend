# Discord Bot Token (從 Discord Developer Portal 取得)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application ID (用於註冊斜線指令)
CLIENT_ID=your_application_id_here

# Discord 伺服器 ID
GUILD_ID=your_guild_id_here

# 預設語音頻道 ID (公會戰語音頻道)
DEFAULT_VOICE_CHANNEL_ID=your_voice_channel_id_here

# 通知文字頻道 ID
NOTIFY_CHANNEL_ID=your_text_channel_id_here

# Google Sheets ID (從 Sheet URL 取得)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# LINE 群組邀請連結
LINE_GROUP_URL=your_line_group_url_here
